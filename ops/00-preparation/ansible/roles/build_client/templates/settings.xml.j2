<?xml version="1.0" encoding="UTF-8"?>
<!-- 由 Ansible build_client 角色管理：所有 Maven 请求经 Nexus。 -->
<settings>
  <mirrors>
    <mirror>
      <id>nexus</id>
      <mirrorOf>*</mirrorOf>
      <url>{{ build_nexus_url }}/repository/maven-central/</url>
    </mirror>
  </mirrors>
  <servers>
    <server>
      <id>nexus</id>
      <username>{{ build_reader_user }}</username>
      <password>{{ build_reader_password }}</password>
    </server>
  </servers>
</settings>
