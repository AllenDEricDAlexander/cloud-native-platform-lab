# 由 Ansible node_base 管理（ops/00-preparation/ansible/roles/node_base），请勿手改。
# 持久化到 /var/log/journal，并按容量预算限制占用与保留时间（手册第 6 节）。
[Journal]
Storage=persistent
SystemMaxUse={{ node_journald_system_max_use }}
SystemKeepFree={{ node_journald_system_keep_free }}
MaxRetentionSec={{ node_journald_max_retention }}
