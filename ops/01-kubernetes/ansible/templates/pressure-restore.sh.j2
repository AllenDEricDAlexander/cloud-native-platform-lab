#!/bin/bash
# 独立于管理 Mac/SSH 的有限回退；只恢复本批暂存的原始字节。
set -euo pipefail
[[ $(id -u) == 0 && $(hostnamectl --static) == worker02.k8s.internal.egon.top ]]
readonly stage=/root/cnpl-replay-pressure-{{ replay_run }}
readonly config=/var/lib/kubelet/config.yaml
exec 9>"$stage/restore.lock"
flock -x 9
original=$(sha256sum "$stage/original.yaml" | cut -d' ' -f1)
[[ "$original" == '{{ pressure_original_sha }}' ]]
current=$(sha256sum "$config" | cut -d' ' -f1)
temporary=
if [[ -f "$stage/temporary.yaml" ]]; then temporary=$(sha256sum "$stage/temporary.yaml" | cut -d' ' -f1); fi
if [[ "$current" != "$original" && "$current" != "$temporary" ]]; then
  echo '恢复停止：kubelet 配置出现第三方修改；保留 cordon 与恢复材料' >&2
  exit 1
fi
if [[ "$current" != "$original" ]]; then
  cp --preserve=all "$stage/original.yaml" "${config}.cnpl-restore"
  mv -f "${config}.cnpl-restore" "$config"
  restorecon "$config"
fi
systemctl restart kubelet
systemctl is-active --quiet kubelet
[[ $(sha256sum "$config" | cut -d' ' -f1) == "$original" ]]
echo '原 kubelet 字节 SHA 与 active 状态确认；可调度状态由 Ansible 验收后恢复'
