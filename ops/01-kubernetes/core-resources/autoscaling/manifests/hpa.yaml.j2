apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: '{{ load_name | default("p09-load") }}'
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
spec:
  scaleTargetRef: {apiVersion: apps/v1, kind: Deployment, name: '{{ load_name | default("p09-load") }}'}
  minReplicas: 1
  maxReplicas: 4
  metrics:
  - type: Resource
    resource:
      name: '{{ hpa_resource | default("cpu") }}'
      target: {type: Utilization, averageUtilization: {{ 120 if hpa_resource | default('cpu') == 'memory' else 60 }}}
  behavior:
    scaleUp: {stabilizationWindowSeconds: 0, policies: [{type: Pods, value: 2, periodSeconds: 15}]}
    scaleDown: {stabilizationWindowSeconds: 30, policies: [{type: Pods, value: 4, periodSeconds: 15}]}
