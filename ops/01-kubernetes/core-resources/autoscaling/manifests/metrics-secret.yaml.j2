# 仅由 secret.yml 在 core_private 中渲染；不会进入公开 manifests/。
apiVersion: v1
kind: Secret
metadata:
  name: metrics-server-tls
  namespace: '{{ core_metrics_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}', cnpl.io/component: metrics-server, cnpl.io/cluster-uid: '{{ core_cluster_uid }}'}
type: kubernetes.io/tls
data:
  tls.crt: '{{ lookup("file", core_private ~ "/metrics-server/tls.crt", rstrip=false) | b64encode }}'
  tls.key: '{{ lookup("file", core_private ~ "/metrics-server/tls.key", rstrip=false) | b64encode }}'
