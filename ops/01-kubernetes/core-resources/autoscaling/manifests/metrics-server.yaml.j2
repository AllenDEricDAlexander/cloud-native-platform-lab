apiVersion: apps/v1
kind: Deployment
metadata:
  name: metrics-server
  namespace: '{{ core_metrics_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}', cnpl.io/component: metrics-server, cnpl.io/cluster-uid: '{{ core_cluster_uid }}'}
spec:
  replicas: 2
  selector: {matchLabels: {app.kubernetes.io/name: metrics-server, cnpl.io/cluster-uid: '{{ core_cluster_uid }}'}}
  strategy: {rollingUpdate: {maxUnavailable: 0, maxSurge: 1}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: metrics-server, cnpl.io/core-run: '{{ core_run }}', cnpl.io/cluster-uid: '{{ core_cluster_uid }}'}
      annotations: {cnpl.io/serving-ca-sha256: '{{ core_metrics_ca_pem | hash("sha256") }}'}
    spec:
      serviceAccountName: metrics-server
      automountServiceAccountToken: false
      securityContext: {runAsUser: 1000, runAsGroup: 1000, runAsNonRoot: true, fsGroup: 1000, seccompProfile: {type: RuntimeDefault}}
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms: [{matchExpressions: [{key: kubernetes.io/hostname, operator: In, values: {{ core_workers | to_json }}}]}]
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm: {topologyKey: kubernetes.io/hostname, labelSelector: {matchLabels: {app.kubernetes.io/name: metrics-server}}}
      containers:
      - name: metrics-server
        image: '{{ core_metrics_image }}'
        imagePullPolicy: IfNotPresent
        args: [--secure-port=8443, --tls-cert-file=/tls/tls.crt, --tls-private-key-file=/tls/tls.key, '--kubelet-preferred-address-types=InternalIP,Hostname', --kubelet-use-node-status-port, --kubelet-certificate-authority=/kubelet-ca/ca.crt, --metric-resolution=15s]
        ports: [{name: https, containerPort: 8443}]
        resources: {requests: {cpu: 100m, memory: 200Mi}, limits: {cpu: 500m, memory: 512Mi}}
        securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
        readinessProbe: {httpGet: {path: /readyz, port: https, scheme: HTTPS}, initialDelaySeconds: 15, periodSeconds: 5}
        livenessProbe: {httpGet: {path: /livez, port: https, scheme: HTTPS}, initialDelaySeconds: 15, periodSeconds: 10}
        volumeMounts: [{name: tls, mountPath: /tls, readOnly: true}, {name: kubelet-ca, mountPath: /kubelet-ca, readOnly: true}, {name: identity, mountPath: /var/run/secrets/kubernetes.io/serviceaccount, readOnly: true}, {name: tmp, mountPath: /tmp}]
      volumes:
      - {name: tls, secret: {secretName: metrics-server-tls, defaultMode: 288}}
      - {name: kubelet-ca, configMap: {name: kubelet-ca}}
      - name: identity
        projected:
          defaultMode: 288
          sources:
          - serviceAccountToken: {path: token, expirationSeconds: 3600}
          - configMap: {name: kube-root-ca.crt, items: [{key: ca.crt, path: ca.crt}]}
          - downwardAPI: {items: [{path: namespace, fieldRef: {fieldPath: metadata.namespace}}]}
      - {name: tmp, emptyDir: {sizeLimit: 16Mi}}
---
apiVersion: apiregistration.k8s.io/v1
kind: APIService
metadata:
  name: v1beta1.metrics.k8s.io
  labels: {cnpl.io/core-run: '{{ core_run }}', cnpl.io/component: metrics-server, cnpl.io/cluster-uid: '{{ core_cluster_uid }}'}
spec:
  group: metrics.k8s.io
  version: v1beta1
  groupPriorityMinimum: 100
  versionPriority: 100
  service: {name: metrics-server, namespace: '{{ core_metrics_namespace }}', port: 443}
  insecureSkipTLSVerify: false
  caBundle: '{{ core_metrics_ca_pem | b64encode }}'
