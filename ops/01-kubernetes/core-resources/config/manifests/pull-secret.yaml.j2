# dockerconfigjson 含 Registry 凭据，仅在 core_private 下渲染。
apiVersion: v1
kind: Secret
metadata:
  name: '{{ core_pull_secret_name }}'
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: '{{ core_pull_config | to_json | b64encode }}'
