# 私钥不进入公开证据；这不是 Metrics Server 的证书。
apiVersion: v1
kind: Secret
metadata:
  name: p10-app-tls
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
type: kubernetes.io/tls
data:
  tls.crt: '{{ lookup("file", core_private ~ "/app-tls/tls.crt", rstrip=false) | b64encode }}'
  tls.key: '{{ lookup("file", core_private ~ "/app-tls/tls.key", rstrip=false) | b64encode }}'
  ca.crt: '{{ lookup("file", core_private ~ "/app-tls/ca.crt", rstrip=false) | b64encode }}'
