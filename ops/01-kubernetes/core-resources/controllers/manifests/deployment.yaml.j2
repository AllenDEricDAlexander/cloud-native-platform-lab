# Kubernetes 资源主定义；由 Ansible 渲染后直接执行，解析器不生成资源。
apiVersion: apps/v1
kind: Deployment
metadata:
  name: '{{ workload_name | default("p06-main") }}'
  namespace: lab-core
  labels:
    app.kubernetes.io/part-of: cnpl-controller-lab
    cnpl.io/replay-run: '{{ replay_run }}'
    cnpl.io/legacy-stage: '{{ replay_case }}'
    cnpl.io/replay-topic: '{{ replay_topic }}'
    cnpl.io/replay-case: '{{ replay_case }}'
spec:
  replicas: {{ replica_count | default(2) | int }}
  selector:
    matchLabels:
      cnpl.io/replay-run: '{{ replay_run }}'
      cnpl.io/controller-pool: '{{ workload_pool | default("main") }}'
  template:
    metadata:
      labels:
        cnpl.io/replay-variant: '{{ variant | default("v1") }}'
        app.kubernetes.io/part-of: cnpl-controller-lab
        cnpl.io/replay-run: '{{ replay_run }}'
        cnpl.io/legacy-stage: '{{ replay_case }}'
        cnpl.io/controller-pool: '{{ workload_pool | default("main") }}'
        cnpl.io/replay-topic: '{{ replay_topic }}'
        cnpl.io/replay-case: '{{ replay_case }}'
      annotations:
        cnpl.io/template-note: '{{ template_note | default("baseline") }}'
    spec:
      restartPolicy: Always
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 25
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        runAsNonRoot: true
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: app
        image: '{{ workload_image | default(controller_images.v1.image) }}'
        imagePullPolicy: Never
        command:
        - /controller-app
        - server
        env:
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: POD_UID
          valueFrom:
            fieldRef:
              fieldPath: metadata.uid
        - name: FORCE_NOT_READY
          value: '{{ not_ready | default("false") }}'
        terminationMessagePath: /dev/termination-log
        terminationMessagePolicy: File
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
            - ALL
        resources:
          requests:
            cpu: '{{ cpu_request | default("20m") }}'
            memory: 32Mi
            ephemeral-storage: 1Mi
          limits:
            cpu: '{{ cpu_limit | default("500m") }}'
            memory: 128Mi
            ephemeral-storage: 32Mi
        volumeMounts:
        - name: work
          mountPath: /work
        startupProbe:
          httpGet:
            path: /startup
            port: 8080
          periodSeconds: 2
          timeoutSeconds: 3
          failureThreshold: 15
        livenessProbe:
          httpGet:
            path: /live
            port: 8080
          periodSeconds: 2
          timeoutSeconds: 3
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /ready
            port: 8080
          periodSeconds: 2
          timeoutSeconds: 3
          failureThreshold: 1
        lifecycle:
          preStop:
            exec:
              command:
              - /controller-app
              - prestop
              - '5'
      volumes:
      - name: work
        emptyDir:
          sizeLimit: 32Mi
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: kubernetes.io/hostname
                operator: In
                values:
                - worker01.k8s.internal.egon.top
                - worker02.k8s.internal.egon.top
      topologySpreadConstraints:
      - maxSkew: 1
        topologyKey: kubernetes.io/hostname
        whenUnsatisfiable: ScheduleAnyway
        labelSelector:
          matchLabels:
            cnpl.io/replay-run: '{{ replay_run }}'
            cnpl.io/controller-pool: '{{ workload_pool | default("main") }}'
  minReadySeconds: 3
  progressDeadlineSeconds: 45
  revisionHistoryLimit: 10
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
