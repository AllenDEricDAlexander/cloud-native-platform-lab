apiVersion: batch/v1
kind: CronJob
metadata:
  name: 'p09-{{ cron_policy | lower }}'
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}', cnpl.io/core-case: cron, cnpl.io/cron-policy: '{{ cron_policy }}'}
spec:
  schedule: '* * * * *'
  timeZone: Asia/Shanghai
  concurrencyPolicy: '{{ cron_policy }}'
  startingDeadlineSeconds: 30
  suspend: {{ cron_suspend | default(false) | to_json }}
  successfulJobsHistoryLimit: 2
  failedJobsHistoryLimit: 1
  jobTemplate:
    metadata:
      labels: {cnpl.io/core-run: '{{ core_run }}', cnpl.io/core-case: cron, cnpl.io/cron-policy: '{{ cron_policy }}'}
    spec:
      backoffLimit: 0
      activeDeadlineSeconds: 150
      template:
        metadata:
          labels: {cnpl.io/core-run: '{{ core_run }}', cnpl.io/core-case: cron, cnpl.io/cron-policy: '{{ cron_policy }}'}
        spec:
          restartPolicy: Never
          automountServiceAccountToken: false
          terminationGracePeriodSeconds: 10
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms: [{matchExpressions: [{key: kubernetes.io/hostname, operator: In, values: {{ core_workers | to_json }}}]}]
          securityContext: {runAsUser: 1000, runAsGroup: 1000, runAsNonRoot: true, fsGroup: 1000, seccompProfile: {type: RuntimeDefault}}
          containers:
          - name: app
            image: '{{ core_images.v1.image }}'
            imagePullPolicy: Never
            workingDir: /
            command: [/core-lab, sleep, '90']
            securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
            resources: {requests: {cpu: 10m, memory: 16Mi, ephemeral-storage: 1Mi}, limits: {cpu: 200m, memory: 64Mi, ephemeral-storage: 16Mi}}
