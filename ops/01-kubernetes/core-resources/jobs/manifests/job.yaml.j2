apiVersion: batch/v1
kind: Job
metadata:
  name: 'p09-{{ job_mode }}'
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
spec:
  completions: {{ 3 if job_mode == 'retry' else 1 }}
  parallelism: {{ 3 if job_mode == 'retry' else 1 }}
  completionMode: '{{ "Indexed" if job_mode == "retry" else "NonIndexed" }}'
  backoffLimit: {{ 6 if job_mode == 'retry' else 3 if job_mode == 'permanent' else 0 }}
  activeDeadlineSeconds: {{ 15 if job_mode == 'timeout' else 180 }}
  ttlSecondsAfterFinished: 3600
{% if job_mode == 'permanent' %}
  podFailurePolicy:
    rules: [{action: FailJob, onExitCodes: {containerName: app, operator: In, values: [42]}}]
{% endif %}
  template:
    metadata:
      labels: {cnpl.io/core-run: '{{ core_run }}'}
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      serviceAccountName: '{{ "p09-ledger-writer" if job_mode == "retry" else "default" }}'
      terminationGracePeriodSeconds: 10
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms: [{matchExpressions: [{key: kubernetes.io/hostname, operator: In, values: {{ core_workers | to_json }}}]}]
      securityContext: {runAsUser: 1000, runAsGroup: 1000, runAsNonRoot: true, fsGroup: 1000, seccompProfile: {type: RuntimeDefault}}
      containers:
      - name: app
        image: '{{ core_images.v1.image }}'
        imagePullPolicy: Never
        workingDir: /
        command: {{ ['/core-lab','job'] | to_json if job_mode == 'retry' else ['/core-lab','job','permanent'] | to_json if job_mode == 'permanent' else ['/core-lab','sleep','120'] | to_json }}
        env:
        - {name: POD_NAME, valueFrom: {fieldRef: {fieldPath: metadata.name}}}
        - {name: POD_UID, valueFrom: {fieldRef: {fieldPath: metadata.uid}}}
        - {name: POD_NAMESPACE, valueFrom: {fieldRef: {fieldPath: metadata.namespace}}}
        - {name: CORE_RUN, value: '{{ core_run }}'}
{% if job_mode == 'retry' %}
        - name: JOB_COMPLETION_INDEX
          valueFrom: {fieldRef: {fieldPath: "metadata.annotations['batch.kubernetes.io/job-completion-index']"}}
{% endif %}
        securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
        resources: {requests: {cpu: 50m, memory: 32Mi, ephemeral-storage: 1Mi}, limits: {cpu: 200m, memory: 128Mi, ephemeral-storage: 32Mi}}
{% if job_mode == 'retry' %}
        volumeMounts: [{name: identity, mountPath: /var/run/secrets/kubernetes.io/serviceaccount, readOnly: true}]
      volumes:
      - name: identity
        projected:
          defaultMode: 288
          sources:
          - serviceAccountToken: {path: token, expirationSeconds: 600, audience: '{{ core_api_audience }}'}
          - configMap: {name: kube-root-ca.crt, items: [{key: ca.crt, path: ca.crt}]}
          - downwardAPI: {items: [{path: namespace, fieldRef: {fieldPath: metadata.namespace}}]}
{% endif %}
