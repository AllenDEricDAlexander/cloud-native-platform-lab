# Kubernetes 资源主定义；由 Ansible 渲染后直接执行，解析器不生成资源。
apiVersion: v1
kind: ResourceQuota
metadata:
  name: p04-budget
  namespace: lab-core
  labels:
    app.kubernetes.io/part-of: cnpl-pod-lab
    cnpl.io/replay-run: '{{ replay_run }}'
    cnpl.io/replay-topic: '{{ replay_topic }}'
    cnpl.io/replay-case: '{{ replay_case }}'
spec:
  hard:
    pods: '24'
    requests.cpu: '10'
    limits.cpu: '12'
    requests.memory: 1Gi
    limits.memory: 2Gi
    requests.ephemeral-storage: 256Mi
    limits.ephemeral-storage: 1Gi
