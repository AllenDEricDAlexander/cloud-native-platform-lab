# Kubernetes 资源主定义；由 Ansible 渲染后直接执行，解析器不生成资源。
apiVersion: v1
kind: Pod
metadata:
  name: p05-route-client
  namespace: lab-core
  labels:
    app.kubernetes.io/part-of: cnpl-probe-lab
    cnpl.io/probe-stage: readiness
    cnpl.io/probe-role: route-client
    cnpl.io/replay-run: '{{ replay_run }}'
    cnpl.io/replay-topic: '{{ replay_topic }}'
    cnpl.io/replay-case: '{{ replay_case }}'
spec:
  restartPolicy: Always
  automountServiceAccountToken: false
  nodeSelector:
    kubernetes.io/hostname: worker01.k8s.internal.egon.top
  terminationGracePeriodSeconds: 25
  securityContext:
    runAsUser: 1000
    runAsGroup: 1000
    runAsNonRoot: true
    fsGroup: 1000
    seccompProfile:
      type: RuntimeDefault
  containers:
  - name: app
    image: '{{ probe_image }}'
    imagePullPolicy: Never
    command:
    - /probe-lab
    - relay
    env:
    - name: RELAY_TARGET
      value: '{{ service_ip }}:8080'
    terminationMessagePath: /dev/termination-log
    terminationMessagePolicy: File
    securityContext:
      allowPrivilegeEscalation: false
      readOnlyRootFilesystem: true
      capabilities:
        drop:
        - ALL
    resources:
      requests:
        cpu: 20m
        memory: 32Mi
        ephemeral-storage: 1Mi
      limits:
        cpu: 500m
        memory: 128Mi
        ephemeral-storage: 32Mi
    volumeMounts:
    - name: work
      mountPath: /work
    readinessProbe:
      tcpSocket:
        port: 8080
      periodSeconds: 2
      timeoutSeconds: 3
  volumes:
  - name: work
    emptyDir:
      sizeLimit: 32Mi
