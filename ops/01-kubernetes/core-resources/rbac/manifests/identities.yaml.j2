apiVersion: v1
kind: ServiceAccount
metadata:
  name: p10-reader
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
automountServiceAccountToken: false
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: p10-config-reader
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
automountServiceAccountToken: false
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: p10-operator
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: p10-reader
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
rules: [{apiGroups: [''], resources: [pods], verbs: [get,list,watch]}, {apiGroups: [''], resources: [pods/log], verbs: [get]}]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: p10-reader
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: p10-reader}
subjects: [{kind: ServiceAccount, name: p10-reader, namespace: '{{ core_namespace }}'}]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: 'cnpl-p10-config-{{ core_run | lower }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
rules: [{apiGroups: [''], resources: [configmaps], resourceNames: [p10-config], verbs: [get]}]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: p10-config-reader
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: 'cnpl-p10-config-{{ core_run | lower }}'}
subjects: [{kind: ServiceAccount, name: p10-config-reader, namespace: '{{ core_namespace }}'}]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: p10-operator
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
rules: [{apiGroups: [''], resources: [configmaps], resourceNames: [p10-delete-allowed], verbs: [get,delete]}]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: p10-operator
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: p10-operator}
subjects: [{kind: ServiceAccount, name: p10-operator, namespace: '{{ core_namespace }}'}]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: 'cnpl-p10-nodes-{{ core_run | lower }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
rules: [{apiGroups: [''], resources: [nodes], verbs: [get,list,watch]}]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: 'cnpl-p10-nodes-{{ core_run | lower }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: 'cnpl-p10-nodes-{{ core_run | lower }}'}
subjects: [{kind: ServiceAccount, name: p10-reader, namespace: '{{ core_namespace }}'}]
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: p10-delete-allowed
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
data: {purpose: allowed-delete}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: p10-delete-denied
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
data: {purpose: denied-delete}
