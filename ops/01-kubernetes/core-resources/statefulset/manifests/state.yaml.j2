apiVersion: v1
kind: Service
metadata:
  name: '{{ state_name | default("p07-state") }}-headless'
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
spec:
  clusterIP: None
  selector: {app.kubernetes.io/name: '{{ state_name | default("p07-state") }}', cnpl.io/core-run: '{{ core_run }}'}
  ports: [{name: http, port: 8080, targetPort: http}]
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: '{{ state_name | default("p07-state") }}'
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
spec:
  serviceName: '{{ state_name | default("p07-state") }}-headless'
  replicas: {{ state_count | default(2) }}
  podManagementPolicy: '{{ state_policy | default("OrderedReady") }}'
  revisionHistoryLimit: 5
  updateStrategy:
    type: '{{ state_strategy | default("RollingUpdate") }}'
    rollingUpdate: {{ {'partition':state_partition | default(0) | int} | to_json if state_strategy | default('RollingUpdate') == 'RollingUpdate' else 'null' }}
  selector:
    matchLabels: {app.kubernetes.io/name: '{{ state_name | default("p07-state") }}', cnpl.io/core-run: '{{ core_run }}'}
  template:
    metadata:
      labels: {app.kubernetes.io/name: '{{ state_name | default("p07-state") }}', cnpl.io/core-run: '{{ core_run }}'}
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 10
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms: [{matchExpressions: [{key: kubernetes.io/hostname, operator: In, values: {{ core_workers | to_json }}}]}]
      securityContext: {runAsUser: 1000, runAsGroup: 1000, runAsNonRoot: true, fsGroup: 1000, seccompProfile: {type: RuntimeDefault}}
      containers:
      - name: app
        image: '{{ core_images[state_version | default("v1")].image }}'
        imagePullPolicy: Never
        command: [/core-lab, serve]
        env:
        - {name: POD_NAME, valueFrom: {fieldRef: {fieldPath: metadata.name}}}
        - {name: POD_UID, valueFrom: {fieldRef: {fieldPath: metadata.uid}}}
        - {name: POD_NAMESPACE, valueFrom: {fieldRef: {fieldPath: metadata.namespace}}}
        - {name: BLOCK_ORDINAL, value: '{{ state_block | default("") }}'}
        ports: [{name: http, containerPort: 8080}]
        securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
        resources: {requests: {cpu: 20m, memory: 32Mi, ephemeral-storage: 1Mi}, limits: {cpu: 500m, memory: 192Mi, ephemeral-storage: 32Mi}}
        readinessProbe: {httpGet: {path: /ready, port: http}, periodSeconds: 2, timeoutSeconds: 2, failureThreshold: 1}
        livenessProbe: {httpGet: {path: /live, port: http}, periodSeconds: 5, timeoutSeconds: 2}
        volumeMounts: [{name: work, mountPath: /work}]
      volumes: [{name: work, emptyDir: {sizeLimit: 32Mi}}]
