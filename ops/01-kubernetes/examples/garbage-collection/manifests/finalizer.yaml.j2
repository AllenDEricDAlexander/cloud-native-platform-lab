# 两个对象都只是本批模拟资源，不代表云资源/PVC 的真实回收控制器。
apiVersion: v1
kind: ConfigMap
metadata:
  name: p08-external
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
data: {state: simulated-only}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: p08-finalizer
  namespace: '{{ core_namespace }}'
  labels: {cnpl.io/core-run: '{{ core_run }}'}
  finalizers: [cnpl.io/core-cleanup]
data: {external-name: p08-external}
