# Kubernetes 资源主定义；由 Ansible 渲染后直接执行，解析器不生成资源。
apiVersion: v1
kind: Service
metadata:
  name: p03-entry
  namespace: lab-core
  labels:
    app.kubernetes.io/part-of: cnpl-controller-lab
    cnpl.io/replay-run: '{{ replay_run }}'
    cnpl.io/legacy-stage: '{{ replay_case }}'
    cnpl.io/replay-topic: '{{ replay_topic }}'
    cnpl.io/replay-case: '{{ replay_case }}'
spec:
  selector:
    cnpl.io/replay-run: '{{ replay_run }}'
    cnpl.io/controller-pool: ha
  ports:
  - port: 8080
    targetPort: 8080
