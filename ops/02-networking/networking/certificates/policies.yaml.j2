{% for name, group, resources, expressions in rules %}
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: cnpl-tls-{{ name }}
  labels: {cnpl.io/component: phase02-certificates, cnpl.io/cluster-uid: '{{ tls_context.cluster_uid }}'}
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: ['{{ group }}']
        apiVersions: [v1]
        operations: [CREATE, UPDATE]
        resources: {{ resources | to_json }}
  validations:
{% for expression in expressions %}
    - expression: {{ expression | to_json }}
      message: 'CNPL_TLS_BOUNDARY: {{ name }}'
{% endfor %}
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: cnpl-tls-{{ name }}
  labels: {cnpl.io/component: phase02-certificates, cnpl.io/cluster-uid: '{{ tls_context.cluster_uid }}'}
spec:
  policyName: cnpl-tls-{{ name }}
  validationActions: [Deny]
---
{% endfor %}
