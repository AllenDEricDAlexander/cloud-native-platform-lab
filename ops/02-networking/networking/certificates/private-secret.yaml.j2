# 只在 Mac 私有目录渲染，禁止日志和 records 中出现 Secret 数据。
apiVersion: v1
kind: Secret
metadata:
  name: '{{ tls_secret.name }}'
  namespace: '{{ tls_secret.namespace }}'
  labels:
    cnpl.io/component: phase02-certificates
    cnpl.io/cluster-uid: '{{ tls_context.cluster_uid }}'
{% if tls_secret.profile != 'issuer' %}
    cnpl.io/tls-run: '{{ tls_run }}'
{% endif %}
type: kubernetes.io/tls
data:
  tls.crt: '{{ lookup("file", tls_materials.issuer.fullchain if tls_secret.profile == "issuer" else tls_materials.profiles[tls_secret.profile].fullchain) | b64encode }}'
  tls.key: '{{ lookup("file", tls_materials.issuer.private_key if tls_secret.profile == "issuer" else tls_materials.profiles[tls_secret.profile].private_key) | b64encode }}'
