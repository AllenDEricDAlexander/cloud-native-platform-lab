apiVersion: v1
kind: ConfigMap
metadata:
  name: frr
  namespace: lab-dataplane-vm-admin
  labels:
    cnpl.io/phase-run: '{{ run }}'
data:
  frr.conf: |
    frr defaults traditional
    hostname cnpl-vm-frr
    ip nht resolve-via-default
    ip prefix-list LAB seq 10 permit {{ pod_cidrs[workers[0]] }}
    ip prefix-list LAB seq 20 permit {{ pod_cidrs[workers[1]] }}
    ip prefix-list LAB seq 30 permit 192.168.9.211/32
    ip prefix-list LAB seq 40 permit 192.168.9.212/32
    ip prefix-list LAB seq 50 permit 192.168.9.213/32
    ip prefix-list LAB seq 60 permit 192.168.9.214/32
    route-map ONLY-LAB permit 10
     match ip address prefix-list LAB
    router bgp 65009
     bgp router-id 10.255.255.9
     no bgp ebgp-requires-policy
     no bgp default ipv4-unicast
{% for worker in workers %}
     neighbor {{ peer_ips[worker] }} remote-as 65010
     neighbor {{ peer_ips[worker] }} ebgp-multihop 4
     neighbor {{ peer_ips[worker] }} passive
{% endfor %}
     address-family ipv4 unicast
{% for worker in workers %}
      neighbor {{ peer_ips[worker] }} activate
      neighbor {{ peer_ips[worker] }} route-map ONLY-LAB in
{% endfor %}
     exit-address-family
    exit
  daemons: |
    zebra=yes
    bgpd=yes
    vtysh_enable=yes
    zebra_options=" -A 127.0.0.1 -s 90000000"
    bgpd_options=" -A 127.0.0.1 -n"
  vtysh.conf: |
    service integrated-vtysh-config
---
apiVersion: v1
kind: Pod
metadata:
  name: frr
  namespace: lab-dataplane-vm-admin
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  automountServiceAccountToken: false
  nodeSelector:
    kubernetes.io/hostname: worker01.k8s.internal.egon.top
  containers:
  - name: router
    image: '{{ frr_image }}'
    imagePullPolicy: IfNotPresent
    readinessProbe:
      exec:
        command: [vtysh, -d, bgpd, -c, show bgp ipv4 unicast json]
      initialDelaySeconds: 3
      periodSeconds: 3
      timeoutSeconds: 2
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: 500m
        memory: 256Mi
    securityContext:
      runAsUser: 0
      capabilities:
        add:
        - NET_ADMIN
        - NET_RAW
        - SYS_ADMIN
    volumeMounts:
    - name: config
      mountPath: /etc/frr
      readOnly: true
  volumes:
  - name: config
    configMap:
      name: frr
      defaultMode: 420
