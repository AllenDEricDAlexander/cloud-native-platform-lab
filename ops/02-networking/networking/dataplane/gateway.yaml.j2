apiVersion: gateway.envoyproxy.io/v1alpha1
kind: EnvoyProxy
metadata:
  name: edge
  namespace: lab-dataplane-vm
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  provider:
    type: Kubernetes
    kubernetes:
      envoyDeployment:
        name: '{{ name }}'
        replicas: 2
        pod:
          nodeSelector:
            node-role.kubernetes.io/worker: ''
          labels: &id001
            cnpl.io/phase-run: '{{ run }}'
            cnpl.io/component: phase02-vm-dataplane-edge
          affinity:
            podAntiAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
              - topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchLabels: *id001
        container:
          image: '{{ envoy_image }}'
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
        patch:
          type: StrategicMerge
          value:
            spec:
              template:
                spec:
                  containers:
                  - name: shutdown-manager
                    image: '{{ gateway_image }}'
                metadata:
                  labels: *id001
            metadata:
              labels:
                cnpl.io/phase-run: '{{ run }}'
      envoyService:
        name: '{{ name }}'
        type: NodePort
        externalTrafficPolicy: Cluster
        labels:
          cnpl.io/phase-run: '{{ run }}'
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: edge
  namespace: lab-dataplane-vm
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  gatewayClassName: '{{ gateway_class }}'
  infrastructure:
    parametersRef:
      group: gateway.envoyproxy.io
      kind: EnvoyProxy
      name: edge
    labels:
      cnpl.io/phase-run: '{{ run }}'
  listeners:
  - name: http
    protocol: HTTP
    port: 80
    allowedRoutes:
      namespaces:
        from: Same
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: edge
  namespace: lab-dataplane-vm
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  parentRefs:
  - name: edge
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /
    backendRefs:
    - name: api
      port: 8080
