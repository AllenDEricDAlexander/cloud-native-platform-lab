kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  apiServerAddress: 127.0.0.1
  disableDefaultCNI: true
  kubeProxyMode: iptables
  podSubnet: '{{ pod_cidr }}'
  serviceSubnet: '{{ service_cidr }}'
  ipFamily: ipv4
nodes:
- role: control-plane
  labels:
    cnpl.io/kind-role: control-plane
- role: worker
  labels:
    cnpl.io/kind-role: worker
- role: worker
  labels:
    cnpl.io/kind-role: worker
