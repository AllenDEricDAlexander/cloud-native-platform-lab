apiVersion: cilium.io/v2
kind: CiliumBGPPeerConfig
metadata:
  name: comparison
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  timers:
    connectRetryTimeSeconds: 1
    holdTimeSeconds: 9
    keepAliveTimeSeconds: 3
  gracefulRestart:
    enabled: false
  families:
  - afi: ipv4
    safi: unicast
    advertisements:
      matchLabels:
        advertise: comparison
---
apiVersion: cilium.io/v2
kind: CiliumBGPAdvertisement
metadata:
  name: comparison
  labels:
    cnpl.io/phase-run: '{{ run }}'
    advertise: comparison
spec:
  advertisements:
  - advertisementType: PodCIDR
  - advertisementType: Service
    service:
      addresses:
      - LoadBalancerIP
    selector:
      matchLabels:
        cnpl.io/lb: bgp
---
apiVersion: cilium.io/v2
kind: CiliumBGPClusterConfig
metadata:
  name: comparison
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  nodeSelector:
    matchLabels:
      cnpl.io/kind-role: worker
  bgpInstances:
  - name: comparison
    localASN: 65010
    peers:
    - name: frr
      peerASN: 65009
      peerAddress: '{{ frr_ip }}'
      peerConfigRef:
        name: comparison
---
apiVersion: v1
kind: Service
metadata:
  name: bgp
  namespace: lab-dataplane
  labels:
    cnpl.io/phase-run: '{{ run }}'
    cnpl.io/lb: bgp
spec:
  type: LoadBalancer
  loadBalancerClass: io.cilium/bgp-control-plane
  externalTrafficPolicy: Cluster
  selector:
    app: api
    cnpl.io/phase-run: '{{ run }}'
  ports:
  - name: http
    port: 8080
    targetPort: 8080
