# 仅在私有目录渲染；Ansible no_log，证据只保存 UID 和公开证书指纹。
apiVersion: v1
kind: Secret
metadata:
  name: '{{ gateway_secret.name }}'
  namespace: '{{ gateway_secret.namespace }}'
  labels:
    cnpl.io/component: phase02-gateway
    cnpl.io/cluster-uid: '{{ gateway_context.cluster_uid }}'
{% if gateway_secret.profile != 'primary' %}
    cnpl.io/gateway-run: '{{ gateway_run }}'
{% endif %}
type: kubernetes.io/tls
data:
  tls.crt: '{{ lookup("file", gateway_tls[gateway_secret.profile].fullchain) | b64encode }}'
  tls.key: '{{ lookup("file", gateway_tls[gateway_secret.profile].private_key) | b64encode }}'
