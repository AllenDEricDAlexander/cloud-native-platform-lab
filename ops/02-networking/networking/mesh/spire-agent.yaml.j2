apiVersion: v1
kind: ServiceAccount
metadata:
  name: spire-agent
  namespace: spire-system
  labels:
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: cnpl-spire-agent
  labels:
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
rules:
- apiGroups:
  - ''
  resources:
  - nodes/proxy
  verbs:
  - get
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: cnpl-spire-agent
  labels:
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cnpl-spire-agent
subjects:
- kind: ServiceAccount
  name: spire-agent
  namespace: spire-system
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: spire-agent-config
  namespace: spire-system
  labels:
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
data:
  agent.conf: |
{{ spire_agent_hcl | indent(4, true) }}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: spire-agent
  namespace: spire-system
  labels:
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
spec:
  selector:
    matchLabels:
      app: spire-agent
      cnpl.io/phase-run: '{{ run }}'
      istio.io/use-waypoint: waypoint
  template:
    metadata:
      labels:
        app: spire-agent
        cnpl.io/phase-run: '{{ run }}'
        istio.io/use-waypoint: waypoint
    spec:
      hostPID: true
      serviceAccountName: spire-agent
      automountServiceAccountToken: true
      tolerations:
      - operator: Exists
      containers:
      - name: agent
        image: '{{ spire_agent }}'
        imagePullPolicy: Never
        command:
        - /opt/spire/bin/spire-agent
        args:
        - run
        - -config
        - /run/config/agent.conf
        env:
        - name: MY_NODE_NAME
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
        securityContext:
          privileged: true
          runAsUser: 0
        resources:
          requests:
            cpu: 20m
            memory: 64Mi
          limits:
            cpu: 500m
            memory: 256Mi
        volumeMounts:
        - name: config
          mountPath: /run/config
          readOnly: true
        - name: bundle
          mountPath: /run/bundle
          readOnly: true
        - name: data
          mountPath: /run/spire/data
        - name: socket
          mountPath: /run/spire/sockets
        - name: psat
          mountPath: /var/run/secrets/tokens
          readOnly: true
      volumes:
      - name: config
        configMap:
          name: spire-agent-config
      - name: bundle
        configMap:
          name: spire-bundle
      - name: data
        emptyDir: {}
      - name: socket
        hostPath:
          path: /run/spire/sockets
          type: DirectoryOrCreate
      - name: psat
        projected:
          sources:
          - serviceAccountToken:
              path: spire-agent
              audience: spire-server
              expirationSeconds: 600
