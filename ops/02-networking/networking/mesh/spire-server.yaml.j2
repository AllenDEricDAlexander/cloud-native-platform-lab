apiVersion: v1
kind: Namespace
metadata:
  name: spire-system
  labels:
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
    pod-security.kubernetes.io/enforce: privileged
    istio-injection: disabled
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: spire-server
  namespace: spire-system
  labels:
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: cnpl-spire-server
  labels:
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
rules:
- apiGroups:
  - authentication.k8s.io
  resources:
  - tokenreviews
  verbs:
  - create
- apiGroups:
  - ''
  resources:
  - nodes
  - pods
  - serviceaccounts
  verbs:
  - get
  - list
  - watch
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: cnpl-spire-server
  labels:
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cnpl-spire-server
subjects:
- kind: ServiceAccount
  name: spire-server
  namespace: spire-system
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: spire-server-config
  namespace: spire-system
  labels:
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
data:
  server.conf: |
{{ spire_server_hcl | indent(4, true) }}
---
apiVersion: v1
kind: Pod
metadata:
  name: spire-server
  namespace: spire-system
  labels:
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
    app: spire-server
spec:
  serviceAccountName: spire-server
  automountServiceAccountToken: true
  securityContext:
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
  containers:
  - name: server
    image: '{{ spire_server }}'
    imagePullPolicy: Never
    command:
    - /opt/spire/bin/spire-server
    args:
    - run
    - -config
    - /run/config/server.conf
    securityContext:
      readOnlyRootFilesystem: true
      allowPrivilegeEscalation: false
      capabilities:
        drop:
        - ALL
    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi
    volumeMounts:
    - name: data
      mountPath: /run/spire
    - name: config
      mountPath: /run/config
      readOnly: true
    readinessProbe:
      tcpSocket:
        port: 8081
      periodSeconds: 1
  volumes:
  - name: data
    emptyDir: {}
  - name: config
    configMap:
      name: spire-server-config
---
apiVersion: v1
kind: Service
metadata:
  name: spire-server
  namespace: spire-system
  labels:
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
spec:
  selector:
    app: spire-server
    cnpl.io/phase-run: '{{ run }}'
    istio.io/use-waypoint: waypoint
  ports:
  - port: 8081
    targetPort: 8081
