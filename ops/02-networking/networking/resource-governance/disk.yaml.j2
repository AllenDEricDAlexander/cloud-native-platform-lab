apiVersion: v1
kind: Pod
metadata:
  name: disk
  namespace: lab-qos
  labels:
    cnpl.io/phase-run: '{{ run }}'
    app: disk
spec:
  automountServiceAccountToken: false
  restartPolicy: Never
  nodeSelector:
    kubernetes.io/hostname: worker01.k8s.internal.egon.top
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    seccompProfile:
      type: RuntimeDefault
  containers:
  - name: net
    image: '{{ image }}'
    imagePullPolicy: IfNotPresent
    args:
    - disk
    - '32'
    env:
    - name: POD_UID
      valueFrom:
        fieldRef:
          fieldPath: metadata.uid
    - name: POD_NAME
      valueFrom:
        fieldRef:
          fieldPath: metadata.name
    - name: NODE_NAME
      valueFrom:
        fieldRef:
          fieldPath: spec.nodeName
    securityContext:
      allowPrivilegeEscalation: false
      readOnlyRootFilesystem: true
      capabilities:
        drop:
        - ALL
    resources:
      requests:
        cpu: 20m
        memory: 16Mi
        ephemeral-storage: 8Mi
      limits:
        cpu: 100m
        memory: 64Mi
        ephemeral-storage: 24Mi
    volumeMounts:
    - name: scratch
      mountPath: /work
  volumes:
  - name: scratch
    emptyDir:
      sizeLimit: 16Mi
