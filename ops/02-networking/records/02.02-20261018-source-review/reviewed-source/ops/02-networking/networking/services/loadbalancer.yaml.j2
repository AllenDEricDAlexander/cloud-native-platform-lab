apiVersion: v1
kind: Service
metadata:
  name: '{{ services_lb_name | default("loadbalancer") }}'
  namespace: '{{ services_namespace }}'
  labels: {cnpl.io/services-run: '{{ services_run }}'}
  annotations:
    metallb.io/address-pool: '{{ services_pool }}'
    metallb.io/loadBalancerIPs: '{{ services_vip }}'
spec:
  type: LoadBalancer
  allocateLoadBalancerNodePorts: false
  externalTrafficPolicy: Cluster
  loadBalancerSourceRanges: ['{{ services_context.mac_ip }}/32']
  selector: {app: services-echo, cnpl.io/services-run: '{{ services_run }}'}
  ports: [{name: http, port: 8080, targetPort: http}]
