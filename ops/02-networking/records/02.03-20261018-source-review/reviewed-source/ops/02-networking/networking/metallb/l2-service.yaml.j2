apiVersion: v1
kind: Service
metadata:
  name: '{{ metallb_service_name | default("vip-primary") }}'
  namespace: lab-metallb
  labels:
    cnpl.io/metallb-run: '{{ metallb_run }}'
    cnpl.io/vip-policy: primary
    cnpl.io/owner: lab-platform
  annotations:
    metallb.io/address-pool: cnpl-primary
    metallb.io/loadBalancerIPs: 192.168.9.202
spec:
  type: LoadBalancer
  allocateLoadBalancerNodePorts: false
  externalTrafficPolicy: Cluster
  loadBalancerSourceRanges: ['{{ metallb_context.mac_ip }}/32']
  selector: {app: metallb-echo, cnpl.io/metallb-run: '{{ metallb_run }}'}
  ports: [{name: http, port: 8080, targetPort: http}]
