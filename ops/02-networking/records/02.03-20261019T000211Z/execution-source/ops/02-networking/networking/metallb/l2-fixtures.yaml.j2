apiVersion: v1
kind: Namespace
metadata:
  name: lab-metallb
  labels:
    cnpl.io/metallb-run: '{{ metallb_run }}'
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/enforce-version: v1.36
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: echo
  namespace: lab-metallb
  labels: {cnpl.io/metallb-run: '{{ metallb_run }}'}
spec:
  selector:
    matchLabels: {app: metallb-echo, cnpl.io/metallb-run: '{{ metallb_run }}'}
  template:
    metadata:
      labels: {app: metallb-echo, cnpl.io/metallb-run: '{{ metallb_run }}'}
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 2
      nodeSelector: {node-role.kubernetes.io/worker: ''}
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: net
          image: '{{ metallb_image }}'
          imagePullPolicy: IfNotPresent
          command: [/net-lab, serve]
          env:
            - {name: NODE_NAME, valueFrom: {fieldRef: {fieldPath: spec.nodeName}}}
            - {name: POD_NAME, valueFrom: {fieldRef: {fieldPath: metadata.name}}}
            - {name: POD_UID, valueFrom: {fieldRef: {fieldPath: metadata.uid}}}
          ports: [{name: http, containerPort: 8080}]
          readinessProbe: {httpGet: {path: /, port: http}, periodSeconds: 2, timeoutSeconds: 2}
          resources:
            requests: {cpu: 20m, memory: 16Mi}
            limits: {cpu: 500m, memory: 64Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
