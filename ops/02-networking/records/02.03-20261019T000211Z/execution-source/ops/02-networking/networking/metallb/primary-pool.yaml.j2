apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: cnpl-primary
  namespace: metallb-system
  labels:
    cnpl.io/component: metallb-primary
    cnpl.io/cluster-uid: '{{ metallb_context.cluster_uid }}'
spec:
  addresses: [192.168.9.201-192.168.9.210]
  autoAssign: false
  avoidBuggyIPs: false
  serviceAllocation:
    serviceSelectors:
      - matchLabels: {cnpl.io/vip-policy: primary}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: cnpl-primary
  namespace: metallb-system
  labels:
    cnpl.io/component: metallb-primary
    cnpl.io/cluster-uid: '{{ metallb_context.cluster_uid }}'
spec:
  ipAddressPools: [cnpl-primary]
  interfaces: [ens33]
  nodeSelectors:
    - matchLabels: {kubernetes.io/hostname: worker01.k8s.internal.egon.top}
    - matchLabels: {kubernetes.io/hostname: worker02.k8s.internal.egon.top}
