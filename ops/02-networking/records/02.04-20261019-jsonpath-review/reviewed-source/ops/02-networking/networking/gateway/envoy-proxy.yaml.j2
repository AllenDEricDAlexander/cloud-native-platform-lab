apiVersion: gateway.envoyproxy.io/v1alpha1
kind: EnvoyProxy
metadata:
  name: primary
  namespace: cnpl-gateway
  labels: {cnpl.io/component: phase02-gateway, cnpl.io/cluster-uid: '{{ gateway_context.cluster_uid }}'}
spec:
  concurrency: 2
  shutdown: {drainTimeout: 10s, minDrainDuration: 2s}
  telemetry:
    metrics:
      prometheus: {disable: false}
  provider:
    type: Kubernetes
    kubernetes:
      envoyDeployment:
        name: cnpl-primary
        replicas: 2
        strategy:
          type: RollingUpdate
          rollingUpdate: {maxSurge: 0, maxUnavailable: 1}
        pod:
          nodeSelector: {node-role.kubernetes.io/worker: ''}
          labels: {cnpl.io/component: phase02-gateway-data, cnpl.io/cluster-uid: '{{ gateway_context.cluster_uid }}'}
          affinity:
            podAntiAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                - topologyKey: kubernetes.io/hostname
                  labelSelector:
                    matchLabels: {cnpl.io/component: phase02-gateway-data, cnpl.io/cluster-uid: '{{ gateway_context.cluster_uid }}'}
        container:
          image: '{{ gateway_images.proxy }}'
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {cpu: '1', memory: 512Mi}
        patch:
          type: StrategicMerge
          value:
            metadata:
              labels: {cnpl.io/component: phase02-gateway-data, cnpl.io/cluster-uid: '{{ gateway_context.cluster_uid }}'}
            spec:
              template:
                spec:
                  terminationGracePeriodSeconds: 45
                  containers:
                    - name: shutdown-manager
                      image: '{{ gateway_images.controller }}'
                      resources:
                        requests: {cpu: 10m, memory: 32Mi}
                        limits: {cpu: 200m, memory: 128Mi}
      envoyService:
        name: cnpl-primary
        type: LoadBalancer
        allocateLoadBalancerNodePorts: false
        externalTrafficPolicy: Cluster
        loadBalancerSourceRanges: ['{{ gateway_context.mac_ip }}/32']
        labels:
          cnpl.io/component: phase02-gateway-data
          cnpl.io/cluster-uid: '{{ gateway_context.cluster_uid }}'
          cnpl.io/vip-policy: primary
        annotations:
          metallb.io/address-pool: cnpl-primary
          metallb.io/loadBalancerIPs: 192.168.9.201
