; 由 Ansible dns_server 从 ops/inventory/hosts.yaml 与 networks.yaml 生成，请勿手改。
$TTL 300
@	IN SOA	dns.mgmt.internal.egon.top. hostmaster.internal.egon.top. (
		2026101901	; serial
		3600	; refresh
		600	; retry
		604800	; expire
		300 )	; negative cache TTL
	IN NS	dns.mgmt.internal.egon.top.
