cp03.k8s	IN A	192.168.9.103
dns.mgmt	IN A	192.168.9.11
gitlab.svc	IN A	192.168.9.13
harbor.k8s	IN A	192.168.9.12
infra01.k8s	IN A	192.168.9.104
infra02.k8s	IN A	192.168.9.105
nexus.svc	IN A	192.168.9.14
openwrt.mgmt	IN A	192.168.9.10
storage01.k8s	IN A	192.168.9.106
storage02.k8s	IN A	192.168.9.107
storage03.k8s	IN A	192.168.9.108
worker01.k8s	IN A	192.168.9.109
