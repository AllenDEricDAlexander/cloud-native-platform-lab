crds: {enabled: false}
commonLabels:
  cnpl.io/component: phase02-gateway
  cnpl.io/cluster-uid: '{{ gateway_context.cluster_uid }}'
global:
  images:
    envoyGateway: {image: '{{ gateway_images.controller }}', pullPolicy: IfNotPresent}
    envoyProxy: {image: '{{ gateway_images.proxy }}', pullPolicy: IfNotPresent}
deployment:
  replicas: 1
  pod:
    nodeSelector: {kubernetes.io/hostname: infra01.k8s.internal.egon.top}
  envoyGateway:
    resources:
      requests: {cpu: 100m, memory: 256Mi}
      limits: {cpu: '1', memory: 1Gi}
certgen:
  job:
    nodeSelector: {kubernetes.io/hostname: infra01.k8s.internal.egon.top}
    resources:
      requests: {cpu: 50m, memory: 64Mi}
      limits: {cpu: 500m, memory: 256Mi}
topologyInjector: {enabled: false}
kubernetesClusterDomain: cluster.local
config:
  envoyGateway:
    gateway: {controllerName: gateway.envoyproxy.io/cnpl-primary-controller}
    provider:
      type: Kubernetes
      kubernetes:
        shutdownManager: {image: '{{ gateway_images.controller }}'}
    logging: {level: {default: info}}
