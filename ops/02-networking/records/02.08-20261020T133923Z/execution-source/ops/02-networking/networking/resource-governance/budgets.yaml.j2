apiVersion: v1
kind: ResourceQuota
metadata:
  name: budget
  namespace: lab-resource-app
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  hard:
    requests.cpu: 500m
    limits.cpu: '2'
    requests.memory: 512Mi
    limits.memory: 1Gi
    requests.ephemeral-storage: 64Mi
    limits.ephemeral-storage: 128Mi
    pods: '4'
    services: '2'
    configmaps: '4'
---
apiVersion: v1
kind: LimitRange
metadata:
  name: container-budget
  namespace: lab-resource-app
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  limits:
  - type: Container
    max:
      cpu: '1'
      memory: 256Mi
      ephemeral-storage: 32Mi
    defaultRequest:
      cpu: 100m
      memory: 32Mi
      ephemeral-storage: 8Mi
    default:
      cpu: 200m
      memory: 64Mi
      ephemeral-storage: 16Mi
---
