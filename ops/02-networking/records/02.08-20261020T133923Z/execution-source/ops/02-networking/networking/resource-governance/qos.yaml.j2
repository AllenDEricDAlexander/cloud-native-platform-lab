apiVersion: v1
kind: Pod
metadata:
  name: guaranteed
  namespace: lab-qos
  labels:
    cnpl.io/phase-run: '{{ run }}'
    app: guaranteed
spec:
  automountServiceAccountToken: false
  restartPolicy: Never
  nodeSelector:
    kubernetes.io/hostname: worker01.k8s.internal.egon.top
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    seccompProfile:
      type: RuntimeDefault
  containers:
  - name: net
    image: '{{ image }}'
    imagePullPolicy: IfNotPresent
    args:
    - serve
    env:
    - name: POD_UID
      valueFrom:
        fieldRef:
          fieldPath: metadata.uid
    - name: POD_NAME
      valueFrom:
        fieldRef:
          fieldPath: metadata.name
    - name: NODE_NAME
      valueFrom:
        fieldRef:
          fieldPath: spec.nodeName
    securityContext:
      allowPrivilegeEscalation: false
      readOnlyRootFilesystem: true
      capabilities:
        drop:
        - ALL
    resources:
      requests:
        cpu: 20m
        memory: 32Mi
      limits:
        cpu: 20m
        memory: 32Mi
    readinessProbe:
      httpGet:
        path: /healthz
        port: 8080
      periodSeconds: 1
---
