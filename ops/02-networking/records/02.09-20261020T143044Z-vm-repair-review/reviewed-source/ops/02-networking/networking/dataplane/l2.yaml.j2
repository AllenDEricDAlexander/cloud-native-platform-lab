apiVersion: cilium.io/v2
kind: CiliumLoadBalancerIPPool
metadata:
  name: '{{ name }}'
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  blocks:
  - start: 192.168.9.211
    stop: 192.168.9.214
  serviceSelector:
    matchLabels:
      cnpl.io/phase-run: '{{ run }}'
---
apiVersion: cilium.io/v2alpha1
kind: CiliumL2AnnouncementPolicy
metadata:
  name: '{{ name }}'
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  serviceSelector:
    matchLabels:
      cnpl.io/phase-run: '{{ run }}'
      cnpl.io/lb: l2
  nodeSelector:
    matchExpressions:
    - key: kubernetes.io/hostname
      operator: In
      values:
      - worker01.k8s.internal.egon.top
      - worker02.k8s.internal.egon.top
    - key: cnpl.io/phase02-l2-exclude
      operator: DoesNotExist
  interfaces:
  - ^ens33$
  loadBalancerIPs: true
---
apiVersion: v1
kind: Service
metadata:
  name: l2
  namespace: lab-dataplane-vm
  labels:
    cnpl.io/phase-run: '{{ run }}'
    cnpl.io/lb: l2
spec:
  type: LoadBalancer
  loadBalancerClass: io.cilium/l2-announcer
  externalTrafficPolicy: Cluster
  selector:
    app: api
    cnpl.io/phase-run: '{{ run }}'
  ports:
  - name: http
    port: 8080
    targetPort: 8080
