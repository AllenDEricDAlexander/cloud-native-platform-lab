apiVersion: v1
kind: Pod
metadata:
  name: proxy-cleanup-0
  namespace: lab-dataplane-vm-admin
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  nodeName: cp01.k8s.internal.egon.top
  restartPolicy: Never
  automountServiceAccountToken: false
  hostNetwork: true
  dnsPolicy: ClusterFirstWithHostNet
  tolerations:
  - operator: Exists
  containers:
  - name: cleanup
    image: '{{ kube_proxy_image }}'
    imagePullPolicy: IfNotPresent
    command:
    - /usr/local/bin/kube-proxy
    - --cleanup
    - --proxy-mode=iptables
    securityContext:
      runAsUser: 0
      privileged: true
    resources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        cpu: 500m
        memory: 256Mi
    volumeMounts:
    - name: modules
      mountPath: /lib/modules
      readOnly: true
    - name: lock
      mountPath: /run/xtables.lock
  volumes:
  - name: modules
    hostPath:
      path: /lib/modules
      type: Directory
  - name: lock
    hostPath:
      path: /run/xtables.lock
      type: FileOrCreate
---
