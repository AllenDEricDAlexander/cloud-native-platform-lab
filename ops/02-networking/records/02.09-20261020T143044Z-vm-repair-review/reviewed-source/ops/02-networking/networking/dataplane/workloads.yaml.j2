apiVersion: v1
kind: Namespace
metadata:
  name: lab-dataplane-vm
  labels:
    cnpl.io/phase-run: '{{ run }}'
    pod-security.kubernetes.io/enforce: restricted
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  namespace: lab-dataplane-vm
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  replicas: 2
  selector:
    matchLabels:
      app: api
      cnpl.io/phase-run: '{{ run }}'
  template:
    metadata:
      labels:
        app: api
        cnpl.io/phase-run: '{{ run }}'
    spec:
      automountServiceAccountToken: false
      nodeSelector:
        node-role.kubernetes.io/worker: ''
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: net
        image: '{{ image }}'
        imagePullPolicy: IfNotPresent
        args:
        - serve
        env:
        - name: POD_UID
          valueFrom:
            fieldRef:
              fieldPath: metadata.uid
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: NODE_NAME
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
            - ALL
        resources:
          requests:
            cpu: 20m
            memory: 32Mi
          limits:
            cpu: 500m
            memory: 128Mi
        readinessProbe:
          httpGet:
            path: /healthz
            port: 8080
          periodSeconds: 1
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
          - topologyKey: kubernetes.io/hostname
            labelSelector:
              matchLabels:
                app: api
                cnpl.io/phase-run: '{{ run }}'
---
apiVersion: v1
kind: Service
metadata:
  name: api
  namespace: lab-dataplane-vm
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  type: NodePort
  selector:
    app: api
    cnpl.io/phase-run: '{{ run }}'
  ports:
  - name: http
    port: 8080
    targetPort: 8080
    nodePort: 31080
  - name: tcp
    port: 9000
    targetPort: 9000
    nodePort: 31090
---
apiVersion: v1
kind: Pod
metadata:
  name: client
  namespace: lab-dataplane-vm
  labels:
    cnpl.io/phase-run: '{{ run }}'
spec:
  automountServiceAccountToken: false
  nodeSelector:
    kubernetes.io/hostname: worker01.k8s.internal.egon.top
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    seccompProfile:
      type: RuntimeDefault
  containers:
  - name: net
    image: '{{ image }}'
    imagePullPolicy: IfNotPresent
    args:
    - serve
    env:
    - name: POD_UID
      valueFrom:
        fieldRef:
          fieldPath: metadata.uid
    - name: POD_NAME
      valueFrom:
        fieldRef:
          fieldPath: metadata.name
    - name: NODE_NAME
      valueFrom:
        fieldRef:
          fieldPath: spec.nodeName
    securityContext:
      allowPrivilegeEscalation: false
      readOnlyRootFilesystem: true
      capabilities:
        drop:
        - ALL
    resources:
      requests:
        cpu: 20m
        memory: 32Mi
      limits:
        cpu: 500m
        memory: 128Mi
    readinessProbe:
      httpGet:
        path: /healthz
        port: 8080
      periodSeconds: 1
    volumeMounts:
    - name: ca
      mountPath: /trust
      readOnly: true
  volumes:
  - name: ca
    configMap:
      name: kube-root-ca.crt
---
apiVersion: v1
kind: Namespace
metadata:
  name: lab-dataplane-vm-admin
  labels:
    cnpl.io/phase-run: '{{ run }}'
    pod-security.kubernetes.io/enforce: privileged
