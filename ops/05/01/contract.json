{
  "schema_version": 1,
  "resource_attributes": ["service.name", "service.namespace", "service.version", "service.instance.id", "deployment.environment.name"],
  "log_fields": ["timestamp", "severity", "service_name", "environment", "version", "trace_id", "span_id", "error_type", "message"],
  "metric_labels": ["service", "environment", "version", "team"],
  "forbidden_metric_labels": ["trace_id", "span_id", "user_id", "request_id", "message_id", "url.full"],
  "forbidden_fields": ["password", "authorization", "cookie", "token", "db.statement", "http.request.body", "http.response.body"],
  "budget": {"metrics_retention_days": 7, "logs_retention_days": 3, "traces_retention_hours": 24, "profiles_retention_hours": 24, "storage_replication": 3, "storage_reserve_fraction": 0.30, "max_daily_raw_gib": 2, "trace_sample_percent": 10, "debug_ttl_minutes": 15},
  "initial_scope": {"zabbix_history_days": 7, "zabbix_trends_days": 90, "agent_interval_seconds": 60}
}
