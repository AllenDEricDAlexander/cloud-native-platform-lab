[cnpl-kubernetes]
name=CNPL Kubernetes RPM
baseurl=https://rpm.svc.internal.egon.top/kubernetes/
enabled=1
proxy=_none_
gpgcheck=1
repo_gpgcheck=1
sslverify=1
gpgkey=file:///etc/pki/rpm-gpg/cnpl/kubernetes.asc file:///etc/pki/rpm-gpg/cnpl/cnpl-metadata.asc
