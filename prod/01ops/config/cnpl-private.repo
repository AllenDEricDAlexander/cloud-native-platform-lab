# /etc/yum.repos.d/cnpl-private.repo
[cnpl-baseos]
name=CNPL Rocky BaseOS
baseurl=https://rpm.svc.internal.egon.top/baseos/
enabled=1
proxy=_none_
gpgcheck=1
repo_gpgcheck=1
sslverify=1
gpgkey=file:///etc/pki/rpm-gpg/cnpl/rocky10.asc file:///etc/pki/rpm-gpg/cnpl/cnpl-metadata.asc
[cnpl-appstream]
name=CNPL Rocky AppStream
baseurl=https://rpm.svc.internal.egon.top/appstream/
enabled=1
proxy=_none_
gpgcheck=1
repo_gpgcheck=1
sslverify=1
gpgkey=file:///etc/pki/rpm-gpg/cnpl/rocky10.asc file:///etc/pki/rpm-gpg/cnpl/cnpl-metadata.asc
