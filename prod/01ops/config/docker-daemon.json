{
  "selinux-enabled": true,
  "iptables": true,
  "ip6tables": true,
  "firewall-backend": "iptables",
  "ipv6": false,
  "bip": "172.31.0.1/24",
  "default-address-pools": [
    {
      "base": "172.30.0.0/16",
      "size": 24
    }
  ],
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
